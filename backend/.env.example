# Copy to backend/.env and fill in real values. Never commit .env.

# ── Google Gemini (required for the agent) ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: separate key for hybrid-memory / global-memory summarization (defaults to GEMINI_API_KEY)
# SUMMARY_GEMINI_API_KEY=

# ── LangSmith (optional tracing) ─────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sql-agent-demo

# ── MySQL / TiDB Cloud (required) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=4000
DB_USER=your_readonly_user
DB_PASSWORD=your_password
DB_NAME=sql_agent_demo
# TiDB Cloud TLS: path to CA PEM (e.g. isrgrootx1.pem in backend/)
# DB_CA_CERT=isrgrootx1.pem

# ── PostgreSQL (optional: chat threads + LangGraph checkpoints + global memory)
# POSTGRES_URI=postgresql://user:pass@localhost:5432/bmcs

# ── OpenSearch semantic cache (optional; needs OpenAI embeddings) ────────────
# OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_INDEX_NAME=sql-agent-cache
# OPENSEARCH_SCHEMA_INDEX_NAME=sql-agent-schema

# ── Schema TTL cache + background sync (OpenSearch schema vectors) ───────────
# SCHEMA_CACHE_TTL_SECONDS=300
# SCHEMA_SYNC_INTERVAL_SECONDS=300
# SCHEMA_SYNC_ENABLED=true
# SCHEMA_INDEX_ENABLED=true
# SCHEMA_RAG_IN_PROMPT=false
# SCHEMA_RAG_TOP_K=8

# ── OpenAI (optional: embeddings + vision for image questions) ───────────────
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_VISION_TIMEOUT_SECONDS=60
# VISION_SCHEMA_CONTEXT_MAX_CHARS=10000

# ── Chat image upload limits (decoded bytes) ─────────────────────────────────
# CHAT_IMAGE_PAYLOAD_MAX_TOTAL_DECODED_BYTES=4194304
# CHAT_IMAGE_PAYLOAD_MAX_PER_IMAGE_DECODED_BYTES=2097152

# ── Agent limits ─────────────────────────────────────────────────────────────
# MAX_SQL_RETRIES=3
# MAX_MULTI_RETRIES=2
# MAX_SUB_QUERIES=4
# MAX_QUERY_LENGTH=400
# MAX_ANALYSIS_CACHE_SIZE=100
# EXCEL_INLINE_LIMIT=100
# MAX_RESULT_ROWS=100

# ── Cross-chat global memory (single user; updated on New Chat) ───────────────
# GLOBAL_MEMORY_ENABLED=true
# GLOBAL_SUMMARY_MAX_CHARS=8000

# ── Hybrid conversation memory (see docs/MEMORY.md) ──────────────────────────
# HYBRID_MEMORY_ENABLED=false
# RECENT_MESSAGE_CAP=30
# SUMMARY_TRIGGER_MESSAGES=60
# MEMORY_SUMMARY_DEBOUNCE_MESSAGES=8
# MAX_CONTEXT_TOKENS_SOFT=120000
# SUMMARY_MAX_CHARS=8000
# STRUCTURED_MEMORY_JSON_MAX_CHARS=4000
# TOOL_DIGEST_MAX_CHARS=6000

# ── Feature flags (optional) ─────────────────────────────────────────────────
# SKIP_MULTI_QUERY_LLM=false
# USE_FAST_SQL_PIPELINE=false
